# 환경 설정 파일 (setup.sh 에 의해 생성, 민감정보 포함)
env.conf

# VM 이미지 파일 (용량이 크므로 git 관리 제외)
*.qcow2

# 번호 디렉토리 내 스크립트 실행 결과물 yaml (21-upgrade 제외)
[0-9][0-9]-*/*.yaml
[0-9][0-9]-*/*.json
!21-upgrade/*.yaml
en/[0-9][0-9]-*/*.yaml
en/[0-9][0-9]-*/*.json
!en/21-upgrade/*.yaml
ko/[0-9][0-9]-*/*.yaml
ko/[0-9][0-9]-*/*.json
!ko/21-upgrade/*.yaml

# en/ko 루트의 실행 결과물 YAML
en/*.yaml
ko/*.yaml

# poc-setup 디렉토리 (POC 실행 중 생성되는 결과물)
poc-setup/

# download.sh 로 생성되는 다운로드 파일
downloads/

# package.sh 로 생성되는 배포 tarball
virt-poc-*.tar.gz

# macOS
.DS_Store
*.swp
