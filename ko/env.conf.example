# =============================================================================
# virt-poc 환경 설정 파일
# setup.sh 실행 시 자동 생성됩니다. 직접 편집도 가능합니다.
# 이 파일을 복사하여 env.conf 로 저장 후 값을 수정하세요.
#
# Lab-specific 변수는 각 lab 스크립트 실행 시 자동으로 추가됩니다.
# =============================================================================

# =============================================================================
# 공통 변수 (setup.sh 에서 설정)
# =============================================================================

# -----------------------------------------------------------------------------
# 네트워크 설정 (NNCP / NAD)
# -----------------------------------------------------------------------------
# NNCP 이름
NNCP_NAME=br-poc-nncp

# NNCP용 노드 네트워크 인터페이스 이름 (예: ens4, eth1)
BRIDGE_INTERFACE=ens4

# 생성할 Linux Bridge 이름
BRIDGE_NAME=br-poc

# Secondary NIC 정적 IP 프리픽스 (cloud-init networkData 설정 시 사용)
SECONDARY_IP_PREFIX=192.168.100

# -----------------------------------------------------------------------------
# 스토리지클래스
# -----------------------------------------------------------------------------
# VM 이미지 업로드에 사용할 스토리지클래스 (setup.sh 실행 시 자동 감지)
STORAGE_CLASS=ocs-external-storagecluster-ceph-rbd

# Golden Image URL (DataVolume HTTP import)
GOLDEN_IMAGE_URL=http://146.56.160.95/poc-golden.qcow2

# Golden Image 로컬 파일 경로 (설정 시 HTTP 대신 virtctl upload 사용)
# GOLDEN_IMAGE_LOCAL=/path/to/poc-golden.qcow2

# -----------------------------------------------------------------------------
# Operator 설치 상태 (setup.sh 자동 감지)
# -----------------------------------------------------------------------------
VIRT_INSTALLED=false
MTV_INSTALLED=false
NMSTATE_INSTALLED=false
OADP_INSTALLED=false
OADP_NS=openshift-adp
GRAFANA_INSTALLED=false
COO_INSTALLED=false
DESCHEDULER_INSTALLED=false
FAR_INSTALLED=false
NMO_INSTALLED=false
NHC_INSTALLED=false
SNR_INSTALLED=false
ODF_INSTALLED=false
LOGGING_INSTALLED=false
LOKI_INSTALLED=false

# =============================================================================
# Lab-specific 변수 (각 lab 스크립트 실행 시 자동 추가)
# 아래는 예시입니다. 실행 시 자동으로 env.conf에 추가됩니다.
# =============================================================================

# 09-alert — VM 알림 설정
# ALERT_VM_NAME=poc-alert-vm
# ALERT_VM_NS=poc-alert

# 14-oadp — S3 Object Storage (Garage / ODF / Custom)
# GARAGE_INSTALLED=false
# GARAGE_ENDPOINT=
# GARAGE_BUCKET=velero
# GARAGE_ACCESS_KEY=
# GARAGE_SECRET_KEY=
# ODF_S3_ENDPOINT=
# ODF_S3_ACCESS_KEY=
# ODF_S3_SECRET_KEY=
# ODF_S3_REGION=us-east-1
# OADP_S3_BUCKET=velero
# OADP_S3_REGION=us-east-1

# 17-far — IPMI/BMC 설정
# FENCE_AGENT_IPS="192.168.1.1 192.168.1.2 192.168.1.3"
# FENCE_AGENT_USER=admin
# FENCE_AGENT_PASS=password

# 20-logging — LokiStack S3
# LOGGING_S3_ENDPOINT=
# LOGGING_S3_BUCKET=loki
# LOGGING_S3_ACCESS_KEY=
# LOGGING_S3_SECRET_KEY=
# LOGGING_S3_REGION=us-east-1
